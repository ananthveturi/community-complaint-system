# ===================================================================
# CiviFix: Community Grievance Management System - Environment Config
# ===================================================================

# Flask Security Secret Key
SECRET_KEY=civifix-production-secret-key-change-in-prod

# -------------------------------------------------------------------
# Gmail SMTP Configuration (For Live Email Delivery)
# -------------------------------------------------------------------
# To receive OTPs and complaint confirmations in your real Gmail:
# 1. Enable 2-Step Verification in your Google Account:
#    https://myaccount.google.com/security
# 2. Generate an App Password under "App passwords":
#    Select App: "Mail", Device: "Other (CiviFix)"
#    Copy the 16-character password (e.g., abcd efgh ijkl mnop)
# 3. Fill in your Gmail address and the 16-character App Password below:

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
MAIL_DEFAULT_SENDER=your_gmail_address@gmail.com

# -------------------------------------------------------------------
# Twilio SMS Configuration (Optional: For Live Cellular SMS OTPs)
# -------------------------------------------------------------------
# Sign up at https://www.twilio.com for free trial credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
