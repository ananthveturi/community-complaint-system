# ==============================================================================
# CiviFix Community Grievance Management System - Environment Configuration
# ==============================================================================

# Flask Session Security
SECRET_KEY=change-this-to-a-strong-secret-key-in-production

# ------------------------------------------------------------------------------
# 1. LIVE GMAIL DELIVERY CONFIGURATION (Complaint Receipt & Email OTP)
# ------------------------------------------------------------------------------
# To receive real emails in your registered Gmail inbox upon submitting complaints:
#
# Step 1: Log in to your Google Account (myaccount.google.com)
# Step 2: Navigate to "Security" -> "2-Step Verification" (must be turned ON)
# Step 3: Scroll to the bottom and click "App Passwords"
# Step 4: Create a password for App: "CiviFix" -> Click "Create"
# Step 5: Copy the 16-character generated password (e.g. "abcd efgh ijkl mnop")
# Step 6: Paste your Gmail address and the 16-character App Password below:

GMAIL_USER=your.gmail.address@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# SMTP Server Details (Defaults are pre-configured for Gmail TLS port 587)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True

# ------------------------------------------------------------------------------
# 2. MOBILE SMS GATEWAY CONFIGURATION (Phone Number OTP)
# ------------------------------------------------------------------------------
# If you want live SMS delivery to citizen phone numbers via Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# NOTE: When live SMS or Gmail credentials are not set, CiviFix automatically
# runs in safe Local/Test mode: OTPs are logged, and an auto-fill test badge
# is provided directly on the webpage so you can test all features offline.
