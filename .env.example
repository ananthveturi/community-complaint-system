# ===================================================================
# CiviFix: Community Grievance Management System - Environment Config
# ===================================================================

# Flask Security Secret Key
SECRET_KEY=civifix-production-secret-key-change-in-prod

# -------------------------------------------------------------------
# OPTION 1: Modern Transactional Email API (RECOMMENDED - Advanced Tech)
# -------------------------------------------------------------------
# Modern portals use transactional email APIs over HTTPS (Port 443).
# Zero SMTP port issues, no Google App Passwords needed, 100% inbox delivery.
#
# Free Resend API (3,000 free emails/month):
# 1. Sign up free at https://resend.com
# 2. Generate an API Key (starts with re_...)
# 3. Paste it below:
RESEND_API_KEY=
RESEND_FROM=CiviFix Grievance <onboarding@resend.dev>

# OR Free Brevo / Sendinblue API (300 free emails/day):
# 1. Sign up free at https://brevo.com
# 2. Get API key from SMTP & API section
BREVO_API_KEY=
BREVO_SENDER_EMAIL=civifix@civifix.org

# -------------------------------------------------------------------
# OPTION 2: Standard Gmail SMTP Configuration
# -------------------------------------------------------------------
# If you prefer using your personal Gmail account directly:
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and 16-character password below:
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_DEFAULT_SENDER=

# -------------------------------------------------------------------
# Mobile SMS Configuration (Optional: For Live Cellular SMS OTPs)
# -------------------------------------------------------------------
# Free trial credentials at https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
